#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if ((EUID == 0)); then
  echo "Run this command as your normal user; it requests sudo when needed." >&2
  exit 1
fi

"$repo_root/bootstrap" "$@"

sudo apt-get update
sudo apt-get upgrade --yes

if command -v flatpak >/dev/null 2>&1; then
  flatpak update --user --noninteractive
fi
