// Zed Helix-mode keymap
// Only contains Zed-specific additions to Helix defaults
//
// Panel toggles (work everywhere):
//   ctrl-]   Project panel
//   ctrl-}   Git panel
//   ctrl-\   Agent panel
//   ctrl-/   Terminal
[
  // Panel toggles (default: open/focus)
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-]": "project_panel::ToggleFocus",
      "ctrl-}": "git_panel::ToggleFocus",
      "ctrl-\\": "agent::ToggleFocus",
      "ctrl-/": "workspace::ToggleBottomDock",
    },
  },
  // Panel toggles (override: close/switch when already in panel)
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "ctrl-]": "workspace::ToggleLeftDock",
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "ctrl-}": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "ctrl-\\": "workspace::ToggleRightDock",
    },
  },
  // Navigation
  {
    "context": "Dock || Terminal || Editor",
    "bindings": {
      "ctrl-shift-h": "workspace::ActivatePaneLeft",
      "ctrl-shift-l": "workspace::ActivatePaneRight",
      "ctrl-shift-k": "workspace::ActivatePaneUp",
      "ctrl-shift-j": "workspace::ActivatePaneDown",
    },
  },
  // Leader key commands (EmptyPane)
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "space o": "projects::OpenRecent",
      "space O": "workspace::Open",
      // eXecute
      "space x g": [
        "task::Spawn",
        {
          "task_name": "lazygit",
          "reveal_target": "center",
        },
      ],
      "space x j": [
        "task::Spawn",
        {
          "task_name": "lazyjj",
          "reveal_target": "center",
        },
      ],
    },
  },
  // Leader key commands (Editor)
  {
    "context": "vim_mode == helix_normal && !menu",
    "bindings": {
      // Panels (override Helix defaults like ctrl-] go-to-definition)
      "ctrl-]": "project_panel::ToggleFocus",
      "ctrl-}": "git_panel::ToggleFocus",
      "ctrl-\\": "agent::ToggleFocus",
      "ctrl-/": "workspace::ToggleBottomDock",
      // Projects
      "space o": "projects::OpenRecent",
      "space O": "workspace::Open",
      // UI
      "space u i": "editor::ToggleInlayHints",
      "space u w": "editor::ToggleSoftWrap",
      // eXecute
      "space x g": [
        "task::Spawn",
        {
          "task_name": "lazygit",
          "reveal_target": "center",
        },
      ],
      "space x j": [
        "task::Spawn",
        {
          "task_name": "lazyjj",
          "reveal_target": "center",
        },
      ],
      "space x f": "editor::Format",
      // Tabs
      "space q": "pane::CloseActiveItem",
      "space Q": "pane::CloseOtherItems",
      "space x q": "pane::CloseAllItems",
      // Version control
      "space v b": "git::Blame",
      "space v d": "editor::ExpandAllDiffHunks",
      "space v D": "editor::CollapseAllDiffHunks",
      "space v a": "git::Diff",
      "space v r": "git::Restore",
      "space v R": "git::RestoreFile",
      // Markdown
      "space m p": "markdown::OpenPreviewToTheSide",
      "space m P": "markdown::OpenPreview",
      // AI
      "ctrl-l": "assistant::InlineAssist",
    },
  },
  // Move lines
  {
    "context": "Editor",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
    },
  },
]
