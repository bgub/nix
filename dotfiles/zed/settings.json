// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
{
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "proxy": "",
  "project_panel": {
    "hide_gitignore": true,
    "indent_size": 10.0,
  },
  "git_panel": {
    "group_by": "none",
    "tree_view": true,
  },
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "split",
  "agent_servers": {
    "cursor": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "helix_mode": true,
  "show_completions_on_input": true,
  "gutter": {
    "min_line_number_digits": 2,
  },
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "copilot",
  },
  "agent": {
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "gpt-5.5",
    },
  },

  // EDITING
  "vim_mode": true,
  "base_keymap": "VSCode",
  "format_on_save": "on",
  "code_actions_on_format": {
    "source.fixAll.biome": true,
    "source.organizeImports.biome": true,
  },
  "languages": {
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
    },
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
    },
    "CSS": {
      "language_servers": [
        "tailwindcss-language-server",
        "!vscode-css-language-server",
      ],
    },
    "Nix": {
      "language_servers": ["nixd", "!nil"],
    },
    "Rust": {
      "tab_size": 4,
    },
  },

  // STYLES
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 14,
  "buffer_line_height": "standard",

  "theme": {
    "mode": "dark",
    "light": "VSCode Light+",
    "dark": "One Dark",
  },
  "tab_size": 2,
  "terminal": {
    "font_family": "FiraCode Nerd Font Mono",
  },
  // SETUP
  "auto_install_extensions": {
    "html": true,
    "ruff": true,
    "nix": true,
    "git-firefly": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
